// Delimiters
DELIMITER(LParen,    "(")
DELIMITER(RParen,    ")")
DELIMITER(LBrace,    "{")
DELIMITER(RBrace,    "}")
DELIMITER(LSquare,   "[")
DELIMITER(RSquare,   "]")
DELIMITER(Semicolon, ";")
DELIMITER(Comma,     ",")
DELIMITER(Period,    ".")
DELIMITER(Ellipsis,  "...")
DELIMITER(Question,  "?")
DELIMITER(Colon,     ":")
DELIMITER(ColonColon,"::")
DELIMITER(Hash,      "#")
DELIMITER(HashHash,  "##")
